{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node outils/construire.cjs",
  "outputDirectory": "dist",
  "installCommand": "",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- . ':(exclude).claude' ':(exclude)CLAUDE.md' ':(exclude)README.md'",
  "redirects": [
    {
      "source": "/entreprise-de-nettoyage-:ville",
      "has": [{ "type": "host", "value": "groupe-aveli.fr" }],
      "destination": "https://aveli-proprete.fr/entreprise-de-nettoyage-:ville",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
